# Valores reais somente em .env ignorado pelo Git ou no gerenciador seguro da hospedagem.
NUXT_DATABASE_URL=
# CA PEM do provedor PostgreSQL, se exigida para validação TLS.
NUXT_DATABASE_CA=
# Pelo menos 32 bytes aleatórios; não reutilize a chave de desenvolvimento em produção.
NUXT_JWT_SECRET=
# Necessários apenas ao executar npm run user:create-admin.
GRAND_CRU_ADMIN_LOGIN=
GRAND_CRU_ADMIN_PASSWORD=

# Dados de negócio ERP somente leitura; exceção restrita a login e refresh no servidor.
ERP_USERNAME=
ERP_PASSWORD=
# Chave exclusiva: 32 bytes aleatórios em base64; não reutilizar NUXT_JWT_SECRET.
# Manter estável entre deploys; trocar exige procedimento de rotação da sessão cifrada.
ERP_TOKEN_ENCRYPTION_KEY=
ERP_STORE_ID=
