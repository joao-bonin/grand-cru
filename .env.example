# Valores reais somente em .env ignorado pelo Git ou no gerenciador seguro da hospedagem.
NUXT_DATABASE_URL=
# CA PEM do provedor PostgreSQL, se exigida para validação TLS.
NUXT_DATABASE_CA=
# Pelo menos 32 bytes aleatórios; não reutilize a chave de desenvolvimento em produção.
NUXT_JWT_SECRET=
# Necessários apenas ao executar npm run user:create-admin.
GRAND_CRU_ADMIN_LOGIN=
GRAND_CRU_ADMIN_PASSWORD=
